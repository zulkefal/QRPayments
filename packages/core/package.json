{
  "name": "@qrpayments/raast-qr",
  "version": "0.1.0",
  "description": "Generate Pakistani bank-transfer payment QR codes from an IBAN and amount.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./src/react.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "react.d.ts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js && npm run typecheck",
    "qr": "node examples/generate.js",
    "typecheck": "tsc -p test-types/tsconfig.json"
  },
  "keywords": [
    "pakistan",
    "raast",
    "iban",
    "qr",
    "payments",
    "shopify"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "types": "./index.d.ts"
}
